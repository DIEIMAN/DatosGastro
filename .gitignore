# === Linea ATLAS_V2 (2026-08-05) ===
# Se versionan las FUENTES, no los productos: scripts/, contenido/, capas/, matrices/,
# los CSV y MD de qa/, los checksums, los manifiestos, los README y CAMBIOS_CONDUCCION.md.
# Los PDF, el .docx y los ZIP ya quedan afuera por las reglas outputs/**/*.pdf y outputs/*.zip
# de mas arriba; estas dos lineas cubren lo que no: los mapas rasterizados de la editable y
# las hojas de contacto del QA visual, que son productos regenerables y pesan ~50 MB.
outputs/polos_gastro/ATLAS_V2/assets_docx/
outputs/polos_gastro/ATLAS_V2/qa/contact_sheets*/
outputs/polos_gastro/ATLAS_V2/qa/render_*/
outputs/polos_gastro/ATLAS_V2/qa/_miniaturas/
outputs/polos_gastro/ATLAS_V2/qa/_paletas/
outputs/polos_gastro/ATLAS_V2/qa/*.png
outputs/polos_gastro/ATLAS_V2/scripts/__pycache__/
outputs/polos_gastro/ATLAS_V2/**/*.zip
outputs/polos_gastro/ATLAS_V2/**/*.docx

# === Barrido de la Ciudad 2026-08: capturas crudas de fuentes externas ===
# Se versionan los scripts y las tablas derivadas, no las descargas. El Relevamiento de Usos
# del Suelo pesa 39,5 MB y se rebaja con la URL del docstring de perfilar_usos_suelo.py; las
# tablas del MOC se rebajan del portal de datos abiertos.
outputs/fuentes_externas/usos_suelo/rus_2022_2024.*
outputs/fuentes_externas/usos_suelo/rus_2017.*
outputs/fuentes_externas/usos_suelo/_control_*.txt
outputs/fuentes_externas/moc/*.csv
outputs/fuentes_externas/moc/*.geojson
outputs/fuentes_externas/moc/_perfil_moc*.txt
outputs/fuentes_externas/usos_suelo/rus_2022_2024_shp.zip
outputs/fuentes_externas/usos_suelo/shp/

