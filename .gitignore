outputs/v2/google_places_raw/
outputs/v2/osm_raw/
outputs/v2/documental_raw/
outputs/v2/**/*.zip
outputs/v2/**/*.pdf
# Versionables (agregados / configuración / esquemas / docs / código), se mantienen fuera
# del ignore por ser no sensibles: data/v2/analytics/, outputs/v2/sanitized/, config/v2/,
# schemas/v2/, docs/datagastro_v2/, src/v2/

