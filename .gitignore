outputs/fuentes_externas/osm/_por_tag/
outputs/fuentes_externas/osm/osm_gastro_caba.json
outputs/fuentes_externas/osm/osm_gastro_poi.csv
outputs/fuentes_externas/overture/*.parquet
outputs/fuentes_externas/overture/overture_gastro_poi.csv
outputs/fuentes_externas/all_the_places/*.zip
