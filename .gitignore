outputs/mercados_caba/internal/
outputs/mercados_caba/internal/google_places_raw/
outputs/mercados_caba/raw/
outputs/mercados_caba/**/*.pdf
outputs/mercados_caba/**/*.zip
# Fuentes internas crudas de mercados (planillas/PDFs/etc.): nunca se versionan.
fuentes_internas_mercados_caba/
.env
