# Casas/fábricas de pastas: salidas crudas con razón social, nombres de personas,
# direcciones e IDs individuales (datos sensibles). La versión sanitizada para informe
# va en outputs/casas_pastas_reporte/ (agregados, sin datos personales).
outputs/casas_pastas/
# Piloto Google Places: resultados crudos con nombres comerciales, direcciones
# e IDs individuales (datos de terceros). No se commitean.
outputs/casas_pastas_google_places/
# Padrón integrado AGC+OSM+Google: contiene nombres/razón social y direcciones
# individuales (datos de terceros / AGC). Los agregados van al informe sanitizado.
outputs/casas_pastas_integrado/
outputs/**/*.pdf
outputs/**/*.html
outputs/casas_pastas_google_places/
# Exports / paquetes compartibles o privados generados localmente (incluye ZIPs y pack privado)
exports/
*.zip
# Secretos / variables de entorno
.env
*.env
# Anexos internos de casas de pastas: listados con nombres individuales para revisión manual
outputs/casas_pastas_reporte/anexos_internos/
# Auditoría de recall / faltantes: crudos de terceros, indicios y resultados a validar
outputs/casas_pastas_recall/

# === DataGastro V2 (Etapa 1) ===
# Datos crudos y procesados con filas individuales sensibles (nombre comercial,
# dirección, place_id/osm_id). No se commitean. Solo se publican agregados sanitizados.
data/v2/raw/
data/v2/processed/
outputs/v2/internal/
outputs/v2/google_places_raw/
outputs/v2/osm_raw/
outputs/v2/documental_raw/
outputs/v2/**/*.zip
outputs/v2/**/*.pdf
# Versionables (agregados / configuración / esquemas / docs / código), se mantienen fuera
# del ignore por ser no sensibles: data/v2/analytics/, outputs/v2/sanitized/, config/v2/,
# schemas/v2/, docs/datagastro_v2/, src/v2/

# === Informe Mercados CABA ===
