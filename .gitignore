# .gitignore de DataGastro. Reescrito el 2026-09-03 (auditoria de flujo): mismas reglas de fondo,
# sin las once redundantes ni las que apuntaban a carpetas que ya no existen. Politica: se
# versionan fuentes (scripts, docs, tablas derivadas livianas, checksums); no se versionan crudos
# de terceros, datos con nombre o contacto individual, renders de QA, binarios pesados ni venvs.

# --- entorno y ruido tecnico -------------------------------------------------------------------
__pycache__/
*.pyc
.DS_Store
.venv/
.venv-tools/
.agent-tools/
node_modules/
.graphify/
.playwright-mcp/
tmp/
cache/

# --- secretos ----------------------------------------------------------------------------------
.env
*.env

# --- cuarentena, archivo y espejos de la raiz (copias de entregables; los originales viven en outputs/)
_delete_candidates/
_archive_historico/
MercadosGastro/final/
MercadosGastro/archive_review/
CasasDePastas/final/
CasasDePastas/archive_review/
Cafesito/
PolosGastro/

# --- binarios y productos regenerables en outputs/ --------------------------------------------
# PDF, HTML, ZIP, DOCX y PPTX salen de generadores versionados; se guardan con .sha256 al lado
# cuando hace falta sellarlos. Los renders de QA se rehacen con scripts/qa/pdf_check.py.
*.zip
outputs/**/*.pdf
outputs/**/*.html
outputs/**/*.docx
outputs/**/*.pptx
outputs/**/qa_*_png/
outputs/**/qa_png_*/
outputs/**/raster_pages/
outputs/**/lo_profile_*/
outputs/analisis_interno/
outputs/inventario_drive/
scripts/outputs/

# --- datos internos / crudos con filas individuales (guardrails 7 y 8) -------------------------
data/internal_raw/
data/internal_processed/
data/v2/raw/
data/v2/processed/
fuentes_internas_mercados_caba/
PROYECTOSGASTROAPARTENOREVISAR/

# Casas de pastas: la build canonica (outputs/casas_pastas/) trae razon social, nombres y
# direcciones individuales; se versionan solo los agregados sanitizados del reporte.
outputs/casas_pastas/
outputs/casas_pastas_google_places/
outputs/casas_pastas_integrado/
outputs/casas_pastas_recall/
outputs/casas_pastas_reporte/anexos_internos/

# DataGastro V2: crudos de Places, OSM y documental. Versionables: analytics, sanitized, config, schemas.
outputs/v2/internal/
outputs/v2/google_places_raw/
outputs/v2/osm_raw/
outputs/v2/documental_raw/

# Mercados CABA: material interno y crudo; se publican agregados en outputs/mercados_caba/sanitized/.
outputs/mercados_caba/internal/
outputs/mercados_caba/raw/

# Polos: Places con place_id y direccion exacta de terceros, estados temporales, metadatos internos.
outputs/polos_gastro/historico/experimentos/google_places_microzonas_piloto/interno/
outputs/polos_gastro/historico/experimentos/google_places_microzonas_ampliacion_v1/interno/
outputs/polos_gastro/historico/experimentos/experimentos_google_places/
outputs/polos_gastro/historico/FASE5-29/fase11_google_places_piloto/tablas/*_interno.csv
outputs/polos_gastro/historico/FASE5-29/fase28_ajustes_finales_informe_politico_v2_1/metadatos/interno/
outputs/polos_gastro/INFORMEFINAL/codex/grupo_b_ejecucion_v1/estado_temporal/
outputs/polos_gastro/INFORMEFINAL/codex/grupo_c_ejecucion_v1/estado_temporal/

# Linea ATLAS_V2: se versionan las fuentes (scripts, contenido, capas, matrices, checksums, README);
# no los mapas rasterizados de la editable ni las hojas de contacto del QA.
outputs/polos_gastro/ATLAS_V2/assets_docx/
outputs/polos_gastro/ATLAS_V2/qa/contact_sheets*/
outputs/polos_gastro/ATLAS_V2/qa/render_*/
outputs/polos_gastro/ATLAS_V2/qa/_miniaturas/
outputs/polos_gastro/ATLAS_V2/qa/_paletas/
outputs/polos_gastro/ATLAS_V2/qa/*.png

# Notebook con salidas embebidas.
notebooks/06_informe_presentacion.ipynb

# --- fuentes externas descargadas (data/fuentes_externas): se versionan bajadores y derivadas ---
# RUS 2022-2024 (39,5 MB, URL en el docstring de perfilar_usos_suelo.py), MOC, Overpass, Overture,
# All The Places, catalogo BA Data, GCBA nuevas y Censo 2022 (INDEC, CC BY 4.0, 66 MB).
data/fuentes_externas/usos_suelo/rus_2022_2024.*
data/fuentes_externas/usos_suelo/rus_2017.*
data/fuentes_externas/usos_suelo/_control_*.txt
data/fuentes_externas/usos_suelo/shp/
data/fuentes_externas/moc/*.csv
data/fuentes_externas/moc/*.geojson
data/fuentes_externas/moc/_perfil_moc*.txt
data/fuentes_externas/osm/_por_tag/
data/fuentes_externas/osm/osm_gastro_caba.json
data/fuentes_externas/osm/osm_gastro_poi.csv
data/fuentes_externas/overture/*.parquet
data/fuentes_externas/overture/overture_gastro_poi.csv
data/fuentes_externas/all_the_places/atp_caba.csv
data/fuentes_externas/badata_catalogo/*.json
data/fuentes_externas/gcba_nuevas/*.xlsx
data/fuentes_externas/gcba_nuevas/*.geojson
data/fuentes_externas/gcba_nuevas/*.csv

# --- Barrido de la Ciudad 2026-08 ------------------------------------------------------------
# La base (`local`, `local_fuente`) trae nombre y direccion de comercios: se regenera con
# build_base_gastronomica.py. Los crudos del ENTUR y los cuatro CSV de vigencia traen telefono y
# mail por establecimiento: se versionan las derivadas *_sin_contacto. Cache USIG: espejo local.
outputs/BARRIDO_CIUDAD_2026-08/base/
outputs/BARRIDO_CIUDAD_2026-08/borrador_polos/pertenencia_local_polo.csv
outputs/BARRIDO_CIUDAD_2026-08/borrador_polos/pertenencia_local_polo_v2.csv
outputs/BARRIDO_CIUDAD_2026-08/**/_cache_usig.json
outputs/BARRIDO_CIUDAD_2026-08/**/_cache_usig_datos_utiles.json
outputs/BARRIDO_CIUDAD_2026-08/entur/crudos/
outputs/BARRIDO_CIUDAD_2026-08/desde_cowork/evidencia_2026/PARA_CHEQUEAR_DIEGO.csv
outputs/BARRIDO_CIUDAD_2026-08/desde_cowork/evidencia_2026/vigencia_tanda_A_centro.csv
outputs/BARRIDO_CIUDAD_2026-08/desde_cowork/evidencia_2026/vigencia_tanda_B_almagro_norte.csv
outputs/BARRIDO_CIUDAD_2026-08/desde_cowork/evidencia_2026/vigencia_verificada_ronda_2.csv
