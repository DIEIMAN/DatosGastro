<?xml version="1.0" encoding="UTF-8"?>
<!--
  WordprocessingML — esquema del subconjunto que usa el .docx del Atlas.

  Por que existe este archivo
  ===========================
  La distribucion oficial de esquemas de ECMA-376 no esta en esta maquina y el generador
  corre sin red, asi que no se puede validar contra wml.xsd tal como lo publica ECMA. Este
  esquema declara, elemento por elemento, el contrato de ATRIBUTOS de cada elemento que el
  paquete .docx contiene de verdad: cuales admite, cuales exige y de que tipo son. Lo que
  no esta declarado no valida: si el generador emitiera manana un elemento o un atributo
  nuevo, la validacion falla en vez de ignorarlo, y por eso el control informa ademas
  cuantos elementos distintos cubrio.

  Modelo de contenido
  ===================
  Los contenedores se declaran con <xs:choice maxOccurs="unbounded">: se valida QUE hijos
  puede tener cada elemento y todos sus atributos, no en que orden vienen. El orden lo
  cubre el control `xml_en_secuencia_ooxml`, que verifica la secuencia de OOXML en lo que
  este generador escribe. Los dos controles son complementarios y estan separados a
  proposito: encodear de memoria las secuencias completas de CT_PPr o CT_RPr tendria mas
  riesgo de dar falsos errores que valor.

  Requeridos
  ==========
  `use="required"` solo donde ECMA-376 lo exige y no hay duda: CT_Zoom/@w:percent — el
  defecto que motivo este control—, CT_PageMar (los siete), CT_String/@w:val,
  CT_DecimalNumber/@w:val, CT_Color/@w:val, CT_Border/@w:val, CT_TabStop/@w:val y @w:pos,
  CT_Font/@w:name, CT_AbstractNum/@w:abstractNumId, CT_Num/@w:numId, CT_Lvl/@w:ilvl,
  CT_TblStylePr/@w:type, CT_LsdException/@w:name, CT_FldChar/@w:fldCharType. En el resto
  los atributos van opcionales.

  Namespaces ajenos
  =================
  `w:shapeDefaults` lleva <xs:any processContents="lax"> para VML, igual que el esquema
  original. El contenido `w14:` lo saca el preproceso de compatibilidad (mc:Ignorable)
  antes de validar, que es lo que hace un consumidor conforme.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
           xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
           xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math"
           xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"
           targetNamespace="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
           elementFormDefault="qualified" attributeFormDefault="qualified">

  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
             schemaLocation="xml.xsd"/>
  <xs:import namespace="http://schemas.openxmlformats.org/officeDocument/2006/relationships"
             schemaLocation="relationships.xsd"/>
  <xs:import namespace="http://schemas.openxmlformats.org/officeDocument/2006/math"
             schemaLocation="math.xsd"/>
  <xs:import namespace="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"
             schemaLocation="dml-wp.xsd"/>

  <!-- ============================ tipos simples ============================ -->

  <xs:simpleType name="ST_OnOff">
    <xs:restriction base="xs:string">
      <xs:enumeration value="true"/>   <xs:enumeration value="false"/>
      <xs:enumeration value="on"/>     <xs:enumeration value="off"/>
      <xs:enumeration value="0"/>      <xs:enumeration value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ST_LongHexNumber">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ST_HexColor">
    <xs:restriction base="xs:string">
      <xs:pattern value="auto|[0-9a-fA-F]{6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ST_FldCharType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="begin"/>
      <xs:enumeration value="separate"/>
      <xs:enumeration value="end"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ST_HdrFtr">
    <xs:restriction base="xs:string">
      <xs:enumeration value="even"/>
      <xs:enumeration value="default"/>
      <xs:enumeration value="first"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ST_Measure">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]+(\.[0-9]+)?(mm|cm|in|pt|pc|pi)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================== tipos reutilizados ========================== -->

  <xs:complexType name="CT_Empty"/>

  <xs:complexType name="CT_OnOff">
    <xs:attribute name="val" type="w:ST_OnOff"/>
  </xs:complexType>

  <xs:complexType name="CT_String">
    <xs:attribute name="val" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CT_DecimalNumber">
    <xs:attribute name="val" type="xs:integer" use="required"/>
  </xs:complexType>

  <xs:complexType name="CT_LongHexNumber">
    <xs:attribute name="val" type="w:ST_LongHexNumber" use="required"/>
  </xs:complexType>

  <xs:complexType name="CT_Measure">
    <xs:attribute name="val" type="w:ST_Measure" use="required"/>
  </xs:complexType>

  <xs:complexType name="CT_Border">
    <xs:attribute name="val" type="xs:string" use="required"/>
    <xs:attribute name="color" type="w:ST_HexColor"/>
    <xs:attribute name="themeColor" type="xs:string"/>
    <xs:attribute name="themeTint" type="xs:string"/>
    <xs:attribute name="themeShade" type="xs:string"/>
    <xs:attribute name="sz" type="xs:nonNegativeInteger"/>
    <xs:attribute name="space" type="xs:nonNegativeInteger"/>
    <xs:attribute name="shadow" type="w:ST_OnOff"/>
    <xs:attribute name="frame" type="w:ST_OnOff"/>
  </xs:complexType>

  <xs:complexType name="CT_TblWidth">
    <xs:attribute name="w" type="xs:string"/>
    <xs:attribute name="type" type="xs:string"/>
  </xs:complexType>

  <!-- ============================== settings =============================== -->

  <xs:element name="settings">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="zoom">
          <xs:complexType>
            <!-- El defecto que este control tiene que ver: `w:percent` es requerido. -->
            <xs:attribute name="val" type="xs:string"/>
            <xs:attribute name="percent" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="proofState">
          <xs:complexType>
            <xs:attribute name="spelling" type="xs:string"/>
            <xs:attribute name="grammar" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="defaultTabStop" type="w:CT_DecimalNumber"/>
        <xs:element name="characterSpacingControl" type="w:CT_String"/>
        <xs:element name="savePreviewPicture" type="w:CT_OnOff"/>
        <xs:element name="doNotAutoCompressPictures" type="w:CT_OnOff"/>
        <xs:element name="decimalSymbol" type="w:CT_String"/>
        <xs:element name="listSeparator" type="w:CT_String"/>
        <xs:element name="themeFontLang">
          <xs:complexType>
            <xs:attribute name="val" type="xs:string"/>
            <xs:attribute name="eastAsia" type="xs:string"/>
            <xs:attribute name="bidi" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="clrSchemeMapping">
          <xs:complexType>
            <xs:attribute name="bg1" type="xs:string"/>
            <xs:attribute name="t1" type="xs:string"/>
            <xs:attribute name="bg2" type="xs:string"/>
            <xs:attribute name="t2" type="xs:string"/>
            <xs:attribute name="accent1" type="xs:string"/>
            <xs:attribute name="accent2" type="xs:string"/>
            <xs:attribute name="accent3" type="xs:string"/>
            <xs:attribute name="accent4" type="xs:string"/>
            <xs:attribute name="accent5" type="xs:string"/>
            <xs:attribute name="accent6" type="xs:string"/>
            <xs:attribute name="hyperlink" type="xs:string"/>
            <xs:attribute name="followedHyperlink" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="shapeDefaults">
          <xs:complexType>
            <xs:sequence>
              <xs:any processContents="lax" namespace="##other"
                      minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="compat">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="useFELayout" type="w:CT_OnOff"/>
              <xs:element name="compatSetting">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string"/>
                  <xs:attribute name="uri" type="xs:string"/>
                  <xs:attribute name="val" type="xs:string"/>
                </xs:complexType>
              </xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="rsids">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="rsidRoot" type="w:CT_LongHexNumber"/>
              <xs:element name="rsid" type="w:CT_LongHexNumber"/>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element ref="m:mathPr"/>
      </xs:choice>
      <xs:attribute ref="w:conformance"/>
    </xs:complexType>
  </xs:element>

  <xs:attribute name="conformance" type="xs:string"/>

  <!-- ============================ webSettings ============================== -->

  <xs:element name="webSettings">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="doNotSaveAsSingleFile" type="w:CT_OnOff"/>
        <xs:element name="allowPNG" type="w:CT_OnOff"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- ============================== fontTable ============================== -->

  <xs:element name="fonts">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="font">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="panose1" type="w:CT_String"/>
              <xs:element name="charset">
                <xs:complexType>
                  <xs:attribute name="val" type="xs:string"/>
                  <xs:attribute name="characterSet" type="xs:string"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="family" type="w:CT_String"/>
              <xs:element name="notTrueType" type="w:CT_OnOff"/>
              <xs:element name="pitch" type="w:CT_String"/>
              <xs:element name="sig">
                <xs:complexType>
                  <xs:attribute name="usb0" type="w:ST_LongHexNumber" use="required"/>
                  <xs:attribute name="usb1" type="w:ST_LongHexNumber" use="required"/>
                  <xs:attribute name="usb2" type="w:ST_LongHexNumber" use="required"/>
                  <xs:attribute name="usb3" type="w:ST_LongHexNumber" use="required"/>
                  <xs:attribute name="csb0" type="w:ST_LongHexNumber" use="required"/>
                  <xs:attribute name="csb1" type="w:ST_LongHexNumber" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:choice>
            <xs:attribute name="name" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- ========================= propiedades de texto ======================== -->

  <xs:complexType name="CT_RPr">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rFonts">
        <xs:complexType>
          <xs:attribute name="hint" type="xs:string"/>
          <xs:attribute name="ascii" type="xs:string"/>
          <xs:attribute name="hAnsi" type="xs:string"/>
          <xs:attribute name="eastAsia" type="xs:string"/>
          <xs:attribute name="cs" type="xs:string"/>
          <xs:attribute name="asciiTheme" type="xs:string"/>
          <xs:attribute name="hAnsiTheme" type="xs:string"/>
          <xs:attribute name="eastAsiaTheme" type="xs:string"/>
          <xs:attribute name="cstheme" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="b" type="w:CT_OnOff"/>
      <xs:element name="bCs" type="w:CT_OnOff"/>
      <xs:element name="i" type="w:CT_OnOff"/>
      <xs:element name="iCs" type="w:CT_OnOff"/>
      <xs:element name="smallCaps" type="w:CT_OnOff"/>
      <xs:element name="color">
        <xs:complexType>
          <xs:attribute name="val" type="w:ST_HexColor" use="required"/>
          <xs:attribute name="themeColor" type="xs:string"/>
          <xs:attribute name="themeTint" type="xs:string"/>
          <xs:attribute name="themeShade" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="spacing" type="w:CT_Measure"/>
      <xs:element name="kern" type="w:CT_DecimalNumber"/>
      <xs:element name="sz" type="w:CT_DecimalNumber"/>
      <xs:element name="szCs" type="w:CT_DecimalNumber"/>
      <xs:element name="u">
        <xs:complexType>
          <xs:attribute name="val" type="xs:string"/>
          <xs:attribute name="color" type="w:ST_HexColor"/>
          <xs:attribute name="themeColor" type="xs:string"/>
          <xs:attribute name="themeTint" type="xs:string"/>
          <xs:attribute name="themeShade" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="lang">
        <xs:complexType>
          <xs:attribute name="val" type="xs:string"/>
          <xs:attribute name="eastAsia" type="xs:string"/>
          <xs:attribute name="bidi" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="rStyle" type="w:CT_String"/>
    </xs:choice>
  </xs:complexType>

  <!-- ======================= propiedades de parrafo ======================== -->

  <xs:complexType name="CT_PPr">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="pStyle" type="w:CT_String"/>
      <xs:element name="keepNext" type="w:CT_OnOff"/>
      <xs:element name="keepLines" type="w:CT_OnOff"/>
      <xs:element name="widowControl" type="w:CT_OnOff"/>
      <xs:element name="contextualSpacing" type="w:CT_OnOff"/>
      <xs:element name="numPr">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="ilvl" type="w:CT_DecimalNumber"/>
            <xs:element name="numId" type="w:CT_DecimalNumber"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="pBdr">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="top" type="w:CT_Border"/>
            <xs:element name="left" type="w:CT_Border"/>
            <xs:element name="bottom" type="w:CT_Border"/>
            <xs:element name="right" type="w:CT_Border"/>
            <xs:element name="between" type="w:CT_Border"/>
            <xs:element name="bar" type="w:CT_Border"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="tabs">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="tab">
              <xs:complexType>
                <xs:attribute name="val" type="xs:string" use="required"/>
                <xs:attribute name="leader" type="xs:string"/>
                <xs:attribute name="pos" type="xs:string" use="required"/>
              </xs:complexType>
            </xs:element>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="spacing">
        <xs:complexType>
          <xs:attribute name="before" type="xs:string"/>
          <xs:attribute name="beforeLines" type="xs:string"/>
          <xs:attribute name="beforeAutospacing" type="w:ST_OnOff"/>
          <xs:attribute name="after" type="xs:string"/>
          <xs:attribute name="afterLines" type="xs:string"/>
          <xs:attribute name="afterAutospacing" type="w:ST_OnOff"/>
          <xs:attribute name="line" type="xs:string"/>
          <xs:attribute name="lineRule" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="ind">
        <xs:complexType>
          <xs:attribute name="left" type="xs:string"/>
          <xs:attribute name="start" type="xs:string"/>
          <xs:attribute name="right" type="xs:string"/>
          <xs:attribute name="end" type="xs:string"/>
          <xs:attribute name="hanging" type="xs:string"/>
          <xs:attribute name="firstLine" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="jc" type="w:CT_String"/>
      <xs:element name="outlineLvl" type="w:CT_DecimalNumber"/>
      <xs:element name="rPr" type="w:CT_RPr"/>
    </xs:choice>
  </xs:complexType>

  <!-- ============================== numbering ============================== -->

  <xs:element name="numbering">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="abstractNum">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="nsid" type="w:CT_LongHexNumber"/>
              <xs:element name="multiLevelType" type="w:CT_String"/>
              <xs:element name="tmpl" type="w:CT_LongHexNumber"/>
              <xs:element name="lvl">
                <xs:complexType>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="start" type="w:CT_DecimalNumber"/>
                    <xs:element name="numFmt" type="w:CT_String"/>
                    <xs:element name="lvlText">
                      <xs:complexType>
                        <xs:attribute name="val" type="xs:string"/>
                        <xs:attribute name="null" type="w:ST_OnOff"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="lvlJc" type="w:CT_String"/>
                    <xs:element name="pStyle" type="w:CT_String"/>
                    <xs:element name="pPr" type="w:CT_PPr"/>
                    <xs:element name="rPr" type="w:CT_RPr"/>
                  </xs:choice>
                  <xs:attribute name="ilvl" type="xs:integer" use="required"/>
                  <xs:attribute name="tplc" type="w:ST_LongHexNumber"/>
                  <xs:attribute name="tentative" type="w:ST_OnOff"/>
                </xs:complexType>
              </xs:element>
            </xs:choice>
            <xs:attribute name="abstractNumId" type="xs:integer" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="num">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="abstractNumId" type="w:CT_DecimalNumber"/>
            </xs:choice>
            <xs:attribute name="numId" type="xs:integer" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- ================================ styles =============================== -->

  <xs:complexType name="CT_TblPr">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="tblStyle" type="w:CT_String"/>
      <xs:element name="tblStyleRowBandSize" type="w:CT_DecimalNumber"/>
      <xs:element name="tblStyleColBandSize" type="w:CT_DecimalNumber"/>
      <xs:element name="tblW" type="w:CT_TblWidth"/>
      <xs:element name="jc" type="w:CT_String"/>
      <xs:element name="tblInd" type="w:CT_TblWidth"/>
      <xs:element name="tblBorders">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="top" type="w:CT_Border"/>
            <xs:element name="start" type="w:CT_Border"/>
            <xs:element name="left" type="w:CT_Border"/>
            <xs:element name="bottom" type="w:CT_Border"/>
            <xs:element name="end" type="w:CT_Border"/>
            <xs:element name="right" type="w:CT_Border"/>
            <xs:element name="insideH" type="w:CT_Border"/>
            <xs:element name="insideV" type="w:CT_Border"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="tblLayout">
        <xs:complexType>
          <xs:attribute name="type" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="tblCellMar">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="top" type="w:CT_TblWidth"/>
            <xs:element name="start" type="w:CT_TblWidth"/>
            <xs:element name="left" type="w:CT_TblWidth"/>
            <xs:element name="bottom" type="w:CT_TblWidth"/>
            <xs:element name="end" type="w:CT_TblWidth"/>
            <xs:element name="right" type="w:CT_TblWidth"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="tblLook">
        <xs:complexType>
          <xs:attribute name="val" type="xs:string"/>
          <xs:attribute name="firstRow" type="w:ST_OnOff"/>
          <xs:attribute name="lastRow" type="w:ST_OnOff"/>
          <xs:attribute name="firstColumn" type="w:ST_OnOff"/>
          <xs:attribute name="lastColumn" type="w:ST_OnOff"/>
          <xs:attribute name="noHBand" type="w:ST_OnOff"/>
          <xs:attribute name="noVBand" type="w:ST_OnOff"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="CT_TcPr">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="tcW" type="w:CT_TblWidth"/>
      <xs:element name="tcBorders">
        <xs:complexType>
          <xs:choice minOccurs="0" maxOccurs="unbounded">
            <xs:element name="top" type="w:CT_Border"/>
            <xs:element name="start" type="w:CT_Border"/>
            <xs:element name="left" type="w:CT_Border"/>
            <xs:element name="bottom" type="w:CT_Border"/>
            <xs:element name="end" type="w:CT_Border"/>
            <xs:element name="right" type="w:CT_Border"/>
            <xs:element name="insideH" type="w:CT_Border"/>
            <xs:element name="insideV" type="w:CT_Border"/>
          </xs:choice>
        </xs:complexType>
      </xs:element>
      <xs:element name="shd">
        <xs:complexType>
          <xs:attribute name="val" type="xs:string" use="required"/>
          <xs:attribute name="color" type="w:ST_HexColor"/>
          <xs:attribute name="fill" type="w:ST_HexColor"/>
          <xs:attribute name="themeFill" type="xs:string"/>
          <xs:attribute name="themeFillTint" type="xs:string"/>
          <xs:attribute name="themeFillShade" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:element name="styles">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="docDefaults">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="rPrDefault">
                <xs:complexType>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="rPr" type="w:CT_RPr"/>
                  </xs:choice>
                </xs:complexType>
              </xs:element>
              <xs:element name="pPrDefault">
                <xs:complexType>
                  <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element name="pPr" type="w:CT_PPr"/>
                  </xs:choice>
                </xs:complexType>
              </xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="latentStyles">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="lsdException">
                <xs:complexType>
                  <xs:attribute name="name" type="xs:string" use="required"/>
                  <xs:attribute name="locked" type="w:ST_OnOff"/>
                  <xs:attribute name="uiPriority" type="xs:integer"/>
                  <xs:attribute name="semiHidden" type="w:ST_OnOff"/>
                  <xs:attribute name="unhideWhenUsed" type="w:ST_OnOff"/>
                  <xs:attribute name="qFormat" type="w:ST_OnOff"/>
                </xs:complexType>
              </xs:element>
