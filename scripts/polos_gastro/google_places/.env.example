# Plantilla de variables de entorno para el piloto Google Places.
# COPIAR a un archivo .env LOCAL (que NO se commitea) y completar con la key real.
# El .env real debe estar en .gitignore. NUNCA commitear la API key.
#
# Este archivo .env.example NO contiene credenciales reales.
# El script acepta GOOGLE_MAPS_API_KEY o, en su defecto, GOOGLE_PLACES_API_KEY.

GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=
