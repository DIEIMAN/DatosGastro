{
  "$system": "DGDGAS Informes — Design System",
  "$version": "1.0.0",
  "$internalName": "DataGastro",
  "$publicBrand": "DGDGAS — Dirección General de Gastronomía",
  "$notes": "DGDGAS es la marca pública. DataGastro es solo nombre interno del sistema/metodología. Valores en HEX y unidades absolutas (pt para tipografía de documento, mm para página, px para pantalla). No inventar datos ni delimitaciones.",

  "color": {
    "brand": {
      "primary":     { "value": "#1F3B57", "use": "Azul institucional. Encabezados de portada, títulos, filas de cabecera de tabla." },
      "primaryDark": { "value": "#16293D", "use": "Fondo de secciones oscuras y variantes de énfasis." },
      "secondary":   { "value": "#2C7FB8", "use": "Azul medio. Barras de datos, acentos de sección, bordes de bloque." },
      "accent":      { "value": "#C0762B", "use": "Cobre/terracota. USO MODERADO: separadores, borde izquierdo de notas, énfasis puntual." }
    },
    "ink": {
      "base":  { "value": "#1B2733", "use": "Texto principal." },
      "muted": { "value": "#566573", "use": "Texto secundario, bajadas." },
      "faint": { "value": "#8A97A3", "use": "Epígrafes, captions, metadatos." }
    },
    "line": {
      "base":   { "value": "#DDE3E9", "use": "Bordes y divisores." },
      "strong": { "value": "#C4CDD6", "use": "Bordes de página/hoja." },
      "soft":   { "value": "#EDF1F4", "use": "Divisores internos de tabla y listas." }
    },
    "surface": {
      "paper":   { "value": "#FFFFFF", "use": "Fondo de hoja." },
      "base":    { "value": "#F4F6F8", "use": "Superficie fría: caja de lectura de resultados." },
      "warm":    { "value": "#F6F4EF", "use": "Superficie cálida: nota metodológica, recomendación." },
      "subtle":  { "value": "#FAFBFC", "use": "Filas alternadas de tabla, fondos muy leves." },
      "desk":    { "value": "#E7EAED", "use": "Fondo de escritorio detrás de las hojas (solo pantalla)." }
    }
  },

  "state": {
    "fuerte":     { "dot": "#2F6E5B", "text": "#245A4A", "bg": "#E9F1EC", "border": "#C7DDD3", "label": "Documentación fuerte" },
    "media":      { "dot": "#2C6E9E", "text": "#245980", "bg": "#E9F0F6", "border": "#C6D9E8", "label": "Documentación media" },
    "debil":      { "dot": "#9A6B1E", "text": "#7E571A", "bg": "#F4EEE1", "border": "#E4D5B8", "label": "Documentación débil" },
    "pendiente":  { "dot": "#5E6B78", "text": "#4C5964", "bg": "#ECEFF1", "border": "#D3DAE0", "label": "Pendiente" },
    "validacion": { "dot": "#A85B2A", "text": "#8A4B22", "bg": "#F4EAE0", "border": "#E4CDB8", "label": "Requiere validación" },
    "enEspera":   { "dot": "#8A97A3", "text": "#4C5964", "bg": "#ECEFF1", "border": "#D3DAE0", "label": "En espera de evidencia" },
    "contexto":   { "dot": "#3F7A86", "text": "#356974", "bg": "#EBF0F1", "border": "#C9DDE0", "label": "Capa objetiva de contexto" },
    "noDelimita": { "dot": "#A85B2A", "text": "#8A4B22", "bg": "#F4EAE0", "border": "#E4CDB8", "hatch": true, "label": "No delimita oficialmente" },
    "anexo":      { "dot": "#6B7280", "text": "#525E6B", "bg": "#EEF0F2", "border": "#D6DCE2", "label": "Anexo / caso secundario" },
    "interno":    { "dot": "#4A5568", "text": "#3E4A57", "bg": "#EBEDF0", "border": "#A9B4BF", "hatch": true, "dashed": true, "label": "Insumo interno / no publicable" },
    "alerta":     { "dot": "#A23A2C", "text": "#8A2E22", "bg": "#F6E9E7", "border": "#E7C9C4", "label": "Advertencia real — SOLO para advertencias reales, nunca para estados de documentación" }
  },

  "typography": {
    "family": {
      "head": { "value": "Libre Franklin", "fallbackDocx": "Arial, Franklin Gothic", "use": "Títulos, encabezados, cifras destacadas." },
      "body": { "value": "Source Sans 3", "fallbackDocx": "Calibri, Segoe UI", "use": "Cuerpo, bajadas, notas." },
      "mono": { "value": "IBM Plex Mono", "fallbackDocx": "Consolas, Courier New", "use": "Epígrafes, metadatos, tokens, códigos de fuente." }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "h1":      { "pt": 26, "px": 34, "weight": 600, "lineHeight": 1.1,  "family": "head", "use": "Título de informe (portada)." },
      "h2":      { "pt": 17, "px": 23, "weight": 600, "lineHeight": 1.15, "family": "head", "use": "Título de sección numerada." },
      "h3":      { "pt": 12.5, "px": 16, "weight": 600, "lineHeight": 1.2, "family": "head", "use": "Subsección / subtítulo." },
      "body":    { "pt": 10.5, "px": 15, "weight": 400, "lineHeight": 1.55, "family": "body", "use": "Cuerpo de texto." },
      "small":   { "pt": 9,  "px": 13,   "weight": 400, "lineHeight": 1.5, "family": "body", "use": "Nota metodológica, texto secundario." },
      "caption": { "pt": 8,  "px": 11.5, "weight": 400, "lineHeight": 1.4, "family": "mono", "letterSpacing": "0.04em", "transform": "uppercase", "use": "Epígrafe, fuente, universo." }
    }
  },

  "space": {
    "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "48px",
    "$scale": "Base 4: 4·8·12·16·24·32·48"
  },

  "radius": {
    "sm": "2px", "md": "4px",
    "$note": "Sobrio e institucional. No superar 4px."
  },

  "border": {
    "hairline": { "width": "1px", "color": "#DDE3E9" },
    "accent":   { "width": "3px", "color": "#C0762B", "position": "left", "use": "Borde izquierdo de nota metodológica y recomendación." }
  },

  "shadow": {
    "print":  "none",
    "screen": "0 3px 10px rgba(31,59,87,0.07)",
    "$note": "Sin sombras al imprimir/exportar PDF. Sombra solo en previsualización de pantalla."
  },

  "page": {
    "size": "A4",
    "orientation": "portrait",
    "landscapeException": "Solo para mapas anchos o tablas extensas.",
    "marginTop": "22mm",
    "marginBottom": "22mm",
    "marginLeft": "20mm",
    "marginRight": "20mm",
    "grid": { "columns": 12, "gutter": "5mm", "textColumnWidth": "~170mm" }
  },

  "table": {
    "header":    { "bg": "#1F3B57", "text": "#EAF0F5", "family": "head", "weight": 600, "size": "12px", "padding": "11px 14px" },
    "cell":      { "text": "#3C4B59", "size": "13px", "padding": "10px 14px", "align": "left", "numericAlign": "right" },
    "cellLead":  { "text": "#1F3B57", "weight": 500 },
    "rowDivider":{ "color": "#EDF1F4", "width": "1px" },
    "rowAlt":    { "bg": "#FAFBFC" },
    "caption":   { "family": "mono", "size": "11px", "color": "#8A97A3", "use": "Universo, fecha de corte, alcance." },
    "$note": "Encabezado azul; alternancia sutil; nunca aspecto de planilla cruda. Estados como chip en celda."
  },

  "chip": {
    "shape":   { "radius": "3px", "padding": "6px 13px 6px 11px", "gap": "8px", "size": "13px" },
    "dot":     { "size": "8px", "radius": "50%" },
    "dotSmall":{ "size": "6px", "radius": "50%", "use": "Chip dentro de celda de tabla." },
    "$note": "El texto siempre nombra el estado; el color es de apoyo. Colores en `state`."
  },

  "map": {
    "barrioFill":     { "value": "#EAEDF0", "opacity": "tenue", "use": "Barrios/comunas de referencia, tono tenue, sin bordes fuertes." },
    "canvasBg":       { "value": "#FAFBFC", "border": "#E4E9EE" },
    "haloNucleo":     { "value": "radial-gradient(circle,#1F3B5744,transparent 70%)", "dot": "#1F3B57" },
    "haloRelevante":  { "value": "radial-gradient(circle,#2C7FB840,transparent 70%)", "dot": "#2C7FB8" },
    "haloEmergente":  { "value": "radial-gradient(circle,#C0762B38,transparent 70%)", "dot": "#C0762B" },
    "anexoDot":       { "value": "#8A97A3" },
    "enEsperaDot":    { "value": "transparent", "border": "1.5px dashed #8A97A3" },
    "disclaimer":     { "color": "#A23A2C", "family": "mono", "text": "Referencia territorial · no delimita oficialmente polos" },
    "sourceCaption":  { "text": "Base cartográfica: Buenos Aires Data — Barrios CABA. No delimitación oficial de polos." },
    "$rules": [
      "Barrios/comunas como soporte en tono tenue; nunca polígonos de polos.",
      "Puntos y halos difusos para subpolos y corredores.",
      "Leyenda breve + fuente cartográfica al pie + disclaimer visible.",
      "No mapas tipo red ni decorativos como visual central.",
      "No usar geometría de plataformas privadas (p. ej. Google Places) como base pública."
    ]
  }
}
